# Copy to backend/.env and fill in. Never commit the real .env.

# Backend-only Meshy API key. Leave empty to boot the app without Meshy calls
# (e.g. for the health check). Required once real generation is exercised.
MESHY_API_KEY=

# Meshy API base URL (override only for testing/mocking).
MESHY_API_BASE=https://api.meshy.ai
