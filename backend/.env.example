# Copy to backend/.env and fill in. Never commit the real .env.

# Backend-only Meshy API key. Leave empty to boot the app without Meshy calls
# (e.g. for the health check). Required once real generation is exercised.
#
# For zero-cost integration testing you can use Meshy's public test-mode key:
#   MESHY_API_KEY=msy_dummy_api_key_for_test_mode_12345678
# It returns the same sample task result for any prompt and consumes no credits.
MESHY_API_KEY=

# Meshy API base URL (override only for testing/mocking).
MESHY_API_BASE=https://api.meshy.ai
